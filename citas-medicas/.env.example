# Base de datos. Por defecto SQLite (cero configuración).
# En producción usa PostgreSQL, por ejemplo:
# DATABASE_URL=postgresql+psycopg2://usuario:password@localhost:5432/citas
DATABASE_URL=sqlite:///./citas.db

# Zona horaria del consultorio
TIMEZONE=America/Mexico_City

# --- WhatsApp (recordatorios) ---
# Proveedor: "stub" (solo registra en consola/BD), "twilio" o "meta"
WHATSAPP_PROVIDER=stub

# Twilio (si WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Meta WhatsApp Business Cloud API (si WHATSAPP_PROVIDER=meta)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
